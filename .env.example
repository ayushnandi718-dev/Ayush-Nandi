# Optional — WebSocket server URL for realtime features (live cursors, chat, presence)
# Leave empty to disable realtime features entirely
NEXT_PUBLIC_WS_URL=

# Optional — Umami analytics
UMAMI_DOMAIN=
UMAMI_SITE_ID=

# Contact form — SMTP (Gmail app password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: defaults to SMTP_USER
CONTACT_TO_EMAIL=

# Admin portal (/admin) — required
# Password used to sign in at /admin
ADMIN_PASSWORD=
# Optional: separate secret for signing the admin session cookie.
# If omitted, ADMIN_PASSWORD is used. Set this to a long random string in production.
ADMIN_SESSION_SECRET=
# Set to 1 for local review: the admin can load content but cannot commit anything.
ADMIN_READ_ONLY=
# Fine-grained GitHub token with Contents: read+write on this repository.
# The admin commits portfolio.json and blog posts through this token.
GITHUB_TOKEN=
GITHUB_REPO_OWNER=ayushnandi718-dev
GITHUB_REPO_NAME=Ayush-Nandi
GITHUB_BRANCH=main
